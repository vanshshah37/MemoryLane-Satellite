# ==============================================================================
# Copernicus Data Space Ecosystem (CDSE) Credentials
# Register free at: https://dataspace.copernicus.eu
# ==============================================================================
CDSE_USERNAME=your_copernicus_username_or_email
CDSE_PASSWORD=your_copernicus_password

# Authentication & STAC Endpoints
CDSE_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1

# ==============================================================================
# Area of Interest (AOI): Manali – Solang Valley, Himachal Pradesh
# Format: min_lon,min_lat,max_lon,max_lat (approx 18 km extent)
# ==============================================================================
AOI_BBOX=77.05,32.15,77.30,32.38
AOI_NAME=manali_solang

# Search Parameters
MAX_CLOUD_COVER=20
SEARCH_START_DATE=2024-09-15
SEARCH_END_DATE=2024-10-31

# ==============================================================================
# Pipeline & Storage Directories (Relative or Absolute paths)
# ==============================================================================
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
COG_OUTPUT_DIR=cog

# ==============================================================================
# TiTiler Tile Server Configuration
# ==============================================================================
TITILER_HOST=127.0.0.1
TITILER_PORT=8000
TITILER_CORS_ORIGIN=*
ACTIVE_COG_PATH=cog/manali_solang_rgb.tif

