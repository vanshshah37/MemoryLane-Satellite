# ==============================================================================
# Copernicus Data Space Ecosystem (CDSE) Credentials
# Register free at: https://dataspace.copernicus.eu
# ==============================================================================
CDSE_USERNAME=your_copernicus_username_or_email
CDSE_PASSWORD=your_copernicus_password

# STAC & Authentication Endpoints
CDSE_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1

# Authenticated S3 EODATA Credentials (optional, generated in CDSE user portal)
CDSE_S3_ACCESS_KEY=your_cdse_s3_access_key
CDSE_S3_SECRET_KEY=your_cdse_s3_secret_key
CDSE_S3_ENDPOINT_URL=https://eodata.dataspace.copernicus.eu

# ==============================================================================
# Area of Interest (AOI): Manali – Solang Valley, Himachal Pradesh
# Extent: min_lon,min_lat,max_lon,max_lat (approx 23.5 km x 25.5 km)
# ==============================================================================
AOI_BBOX=77.05,32.15,77.30,32.38
AOI_NAME=manali_solang

# Search Parameters
MAX_CLOUD_COVER=20
SEARCH_START_DATE=2024-09-15
SEARCH_END_DATE=2024-10-31

# ==============================================================================
# Sentinel-2 Radiometric Calibration (Metadata-Aware BOA Reflectance)
# Formula: R = (DN + BOA_ADD_OFFSET) / QUANTIFICATION_VALUE
# In Baseline >= 04.00 (post Jan 2022), BOA_ADD_OFFSET = -1000, QUANTIFICATION_VALUE = 10000.
# DN = 0 is strictly preserved as NoData.
# ==============================================================================
DEFAULT_QUANTIFICATION_VALUE=10000.0
DEFAULT_BOA_ADD_OFFSET=-1000.0

# ==============================================================================
# Cloud Quality Masking & Edge Buffering Policy
# Mask classes:
#   0: NO_DATA
#   1: SATURATED_OR_DEFECTIVE
#   3: CLOUD_SHADOWS
#   7: UNCLASSIFIED (marginal / questionable quality)
#   8: CLOUD_MEDIUM_PROBABILITY
#   9: CLOUD_HIGH_PROBABILITY
#  10: THIN_CIRRUS
# Snow Class 11 is strictly PRESERVED.
# ==============================================================================
CLOUD_MASK_CLASSES=0,1,3,7,8,9,10
# Cloud edge buffer in meters (upsampled 10m grid: 30m = 3 pixel dilation)
CLOUD_EDGE_BUFFER_METERS=30

# ==============================================================================
# Radiometric Normalization (Fixed BOA Reflectance for Multi-temporal Consistency)
# Fixed bounds applied to true physical reflectance R.
# ==============================================================================
REFLECTANCE_MIN=0.01
REFLECTANCE_MAX=0.32
GAMMA_CORRECTION=1.15

# ==============================================================================
# Pipeline & Storage Directories (Relative or Absolute paths)
# ==============================================================================
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
COG_OUTPUT_DIR=cog

# COG Compression: DEFLATE is the reliable fallback on Windows. WEBP is optional.
COG_COMPRESSION=DEFLATE
COG_PREDICTOR=2

# ==============================================================================
# TiTiler Tile Server Configuration
# ==============================================================================
TITILER_HOST=127.0.0.1
TITILER_PORT=8000
TITILER_CORS_ORIGIN=*
ACTIVE_COG_PATH=cog/manali_solang_rgb.tif
